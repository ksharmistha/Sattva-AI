# ---------------------------------------------------------------------------
# Sattva AI - environment configuration
#
# 1. Copy this file:      cp .env.example .env
# 2. Fill in the values below.
# 3. Restart the Expo dev server (env vars are inlined at bundle time).
#
# Every key is prefixed with EXPO_PUBLIC_ so that the Expo CLI inlines it into
# the client bundle. NOTE: anything with this prefix ships inside the app and
# is readable by anyone who downloads it. That is acceptable for this demo, and
# for Firebase Web config it is expected (Firestore security rules are the real
# access control). The Gemini key is the one value you would move behind a
# backend proxy before any public release - see lib/ai.js.
# ---------------------------------------------------------------------------

# --- Google Gemini -------------------------------------------------------
# Free key from https://aistudio.google.com/app/apikey
# Without this the app still runs and falls back to the offline reply engine.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash.
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# --- Firebase Web config -------------------------------------------------
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
